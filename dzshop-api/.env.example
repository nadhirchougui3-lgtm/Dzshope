# Copie ce fichier en ".env" (dans le dossier dzshop-api) et remplis les vraies valeurs.
# Ne commit JAMAIS le ".env" : seul ce fichier modèle va sur GitHub.

MONGODB_URI=mongodb+srv://UTILISATEUR:MOT_DE_PASSE@cluster0.xxxxx.mongodb.net/dzshop?retryWrites=true&w=majority
JWT_SECRET=mets_ici_une_longue_phrase_secrete_a_toi
PORT=5000

# Connexion avec Google : l'identifiant client (le MÊME que dans le site, variable VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=ton-identifiant.apps.googleusercontent.com

# Images des produits : en local elles vont dans le dossier uploads/.
# En ligne (mise en ligne), mets ici ton lien Cloudinary : cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# En ligne uniquement (séance de mise en ligne) : l'adresse de ton site
FRONTEND_URL=https://ton-site.netlify.app