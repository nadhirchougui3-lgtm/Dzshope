    (() => {
        // Frontend-driven A/B tests only. Backend tests (ftshp-*) are decided server-side and don't go through window.initABTest.
        const KNOWN = [
            'databreakers-crosssell',
            'databreakers-similar-products',
            'databreakers-suggestions',
        ];

        window.__abTestInits = window.__abTestInits || {};
        const buffer = window.__abTestInits;

        const dispatch = (name, data) => {
            if (document.body) {
                document.body.classList.add(name);
            }

            document.dispatchEvent(new CustomEvent('ab-test-init', { detail: { name, data } }));
        };

        window.initABTest = (name, data) => {
            if (!KNOWN.includes(name)) {
                return;
            }

            buffer[name] = { name, data };

            if (document.body) {
                dispatch(name, data);
            } else {
                document.addEventListener('DOMContentLoaded', () => dispatch(name, data), { once: true });
            }
        };
    })();
