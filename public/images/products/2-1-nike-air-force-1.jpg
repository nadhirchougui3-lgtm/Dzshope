,&quot;https://footshop.typeform.com/ai-outfit#outfit_id={outfitId}&quot;],&quot;outfit.aiGenerated.bannerText&quot;:[0,&quot;Gemaakt met AI. Is er iets mis?&quot;],&quot;outfit.report.button.label&quot;:[0,&quot;Meld een probleem&quot;],&quot;catalog.detail.productInfo.labels.sizes&quot;:[0,&quot;Model&quot;],&quot;catalog.detail.delivery.home_to&quot;:[0,&quot;Levering bij jou&quot;],&quot;catalog.detail.delivery.store_pickup&quot;:[0,&quot;Levering naar de winkel&quot;],&quot;catalog.detail.delivery.cutoff&quot;:[0,&quot;Wanneer besteld op {time}&quot;],&quot;catalog.detail.delivery.external&quot;:[0,&quot;We verzenden vanuit een extern magazijn&quot;],&quot;catalog.detail.delivery.more_options&quot;:[0,&quot;Andere verzendopties&quot;],&quot;catalog.detail.delivery.available_at&quot;:[0,&quot;Beschikbaar in&quot;],&quot;catalog.detail.delivery.price_from&quot;:[0,&quot;Vanaf&quot;],&quot;catalog.detail.delivery.dialog.title&quot;:[0,&quot;Verzendopties&quot;],&quot;catalog.detail.delivery.dialog.stores_heading&quot;:[0,&quot;Product in deze maat beschikbaar in winkels&quot;],&quot;catalog.detail.delivery.stores.title&quot;:[0,&quot;Product beschikbaar in winkels&quot;],&quot;catalog.detail.reserve.button&quot;:[0,&quot;Reserveren in de winkel&quot;],&quot;catalog.detail.reserve.title&quot;:[0,&quot;Productreservering&quot;],&quot;catalog.detail.reserve.desc&quot;:[0,&quot;Je reservering is geldig voor 24 uur in de winkel {storeName}.&quot;],&quot;catalog.detail.reserve.submit&quot;:[0,&quot;Reserveren&quot;],&quot;catalog.detail.reserve.form.success.heading&quot;:[0,&quot;Reservering verzonden&quot;],&quot;catalog.detail.reserve.form.error&quot;:[0,&quot;Het is niet gelukt om de reservering te verzenden. Probeer het alstublieft opnieuw.&quot;],&quot;stores.listing.tagline&quot;:[0,&quot;Winkels&quot;],&quot;page.store.title.email&quot;:[0,&quot;E-mail&quot;],&quot;page.store.title.phone&quot;:[0,&quot;Phone&quot;],&quot;page.store.opening_hours.now.open.to&quot;:[0,&quot;Opened&quot;],&quot;page.store.opening_hours.now.closed&quot;:[0,&quot;We gaan binnenkort open&quot;],&quot;aboutPage.hero.upperText&quot;:[0,&quot;Over ons&quot;],&quot;aboutPage.hero.desc&quot;:[0,&quot;Sneakers die je nergens anders vindt.&quot;],&quot;aboutPage.manifest.upperText&quot;:[0,&quot;Voor degenen die gezien willen worden&quot;],&quot;aboutPage.manifest.text&quot;:[0,&quot;Sinds 2011 inspireren we jongeren om te laten zien wie ze zijn en waar ze voor staan door middel van zelfexpressie, roots en creativiteit. We ondersteunen de volgende generatie om cultuur vooruit te helpen en zorgen dat ze de erkenning krijgen die ze verdienen.&quot;],&quot;aboutPage.collabs.upperText&quot;:[0,&quot;Samenwerkingen&quot;],&quot;aboutPage.collabs.title&quot;:[0,&quot;We doen samenwerkingen met{glyph} droommerken&quot;],&quot;aboutPage.products.title&quot;:[0,&quot;Sneakers die je nergens anders vindt{glyph}.&quot;],&quot;aboutPage.products.desc&quot;:[0,&quot;Een zorgvuldig samengestelde selectie van actuele exclusieve releases op één plek. Ontdek limited editions, wereldwijde en interne samenwerkingen, en zeldzame kleurstellingen.&quot;],&quot;aboutPage.products.btn&quot;:[0,&quot;Ontdek Exclusief&quot;],&quot;aboutPage.label.upperText&quot;:[0,&quot;FTSHP Label&quot;],&quot;aboutPage.label.title&quot;:[0,&quot;Geboren uit cultuur&quot;],&quot;aboutPage.label.text&quot;:[0,&quot;Een exclusief, in-house ontworpen kledingmerk, ontstaan uit de cultuur rondom Footshop. Naast het verkopen van kleding voelden we de behoefte om iets meer te creëren, onze eigen collecties met diep gewortelde lokale stemmen. Wat begon als een uitbreiding van de cultuur van Footshop, is uitgegroeid tot een merk dat bij elke drop sterker wordt. Onthoud de naam: FTSHP.&quot;],&quot;aboutPage.stores.upperText&quot;:[0,&quot;Onze winkels&quot;],&quot;aboutPage.stores.title&quot;:[0,&quot;Gemeenschapscentra &amp;{glyph} momenten bouwen&quot;],&quot;aboutPage.blog.upperText&quot;:[0,&quot;Blog&quot;],&quot;aboutPage.blog.title&quot;:[0,&quot;Lees meer{glyph}&quot;],&quot;aboutPage.blog.desc&quot;:[0,&quot;Achter de schermen bij Footshop, verhalen van makers en sneakers, en mode-inspiratie op één plek. Volg onze blog en blijf op de hoogte.&quot;],&quot;aboutPage.blog.btn&quot;:[0,&quot;Alle artikelen&quot;],&quot;aboutPage.blog.card.readMore&quot;:[0,&quot;Lees artikel&quot;],&quot;aboutPage.carousel.prev&quot;:[0,&quot;Vorige&quot;],&quot;aboutPage.carousel.next&quot;:[0,&quot;Volgende&quot;],&quot;appPage.hero.upperText&quot;:[0,&quot;Footshop app&quot;],&quot;appPage.hero.title&quot;:[0,&quot;Snellere shopping.{glyph}Gemakkelijker zoeken.&quot;],&quot;appPage.hero.desc&quot;:[0,&quot;Snellere shopping, betere prijzen, meldingen over de dingen die jij belangrijk vindt. Eén app voor alles waar je van houdt op de site.&quot;],&quot;appPage.hero.rating&quot;:[0,&quot;Beoordeeld met {rating} uit 5&quot;],&quot;appPage.hero.downloads&quot;:[0,&quot;{count} downloads&quot;],&quot;appPage.hero.qr.label&quot;:[0,&quot;Scan om te downloaden&quot;],&quot;appPage.hero.qr.toggle&quot;:[0,&quot;Toon de QR-code om te downloaden&quot;],&quot;appPage.hero.carousel.label&quot;:[0,&quot;Een kijkje in de app&quot;],&quot;appPage.hero.appStore.alt&quot;:[0,&quot;Download op de App Store&quot;],&quot;appPage.hero.googlePlay.alt&quot;:[0,&quot;Haal hem op Google Play&quot;],&quot;appPage.bento.discounts.title&quot;:[0,&quot;Kortingen die je niet op de site zult zien&quot;],&quot;appPage.bento.discounts.text&quot;:[0,&quot;Extra kortingen en beperkte aanbiedingen die geen enkele ster ooit bereikt op het web. Houd de app in de gaten en pak stukken tegen prijzen die niemand anders kent.&quot;],&quot;appPage.bento.discounts.tag&quot;:[0,&quot;Extra -15%&quot;],&quot;appPage.bento.darkMode.title&quot;:[0,&quot;Donkere modus&quot;],&quot;appPage.bento.darkMode.text&quot;:[0,&quot;Makkelijker voor de ogen, een meer premium uitstraling. Gemaakt voor iedereen die liever na donker scrollt en exclusieve deals pakt voordat de zon opkomt.&quot;],&quot;appPage.bento.darkMode.light&quot;:[0,&quot;Lichte{glyph}modus&quot;],&quot;appPage.bento.darkMode.dark&quot;:[0,&quot;Donkere{glyph}modus&quot;],&quot;appPage.bento.push.title&quot;:[0,&quot;Pushmeldingen&quot;],&quot;appPage.bento.push.text&quot;:[0,&quot;Exclusieve drops, alleen in de app-uitverkoop en direct bericht dat je uitverkochte paar weer op voorraad is. Alles recht voor je neus, en sneller dan iedereen anders.&quot;],&quot;appPage.bento.push.notification.discount.title&quot;:[0,&quot;Extra 15 % korting op producten 🚀&quot;],&quot;appPage.bento.push.notification.discount.text&quot;:[0,&quot;Geniet van 15 % korting op je favoriete items!&quot;],&quot;appPage.bento.push.notification.discount.time&quot;:[0,&quot;1 minuut geleden&quot;],&quot;appPage.bento.push.notification.restock.title&quot;:[0,&quot;👀 Raad eens wat weer op voorraad is&quot;],&quot;appPage.bento.push.notification.restock.text&quot;:[0,&quot;We hebben zojuist je gewenste product aangevuld! Bestel het voordat het weer verdwijnt.&quot;],&quot;appPage.bento.push.notification.restock.time&quot;:[0,&quot;1 uur geleden&quot;],&quot;appPage.bento.push.notification.drops.title&quot;:[0,&quot;Bekijk de nieuwe drops!&quot;],&quot;appPage.bento.push.notification.drops.text&quot;:[0,&quot;Je favoriete items zijn online 🔥&quot;],&quot;appPage.bento.push.notification.drops.time&quot;:[0,&quot;Gisteren, 16:06&quot;],&quot;appPage.bento.trending.title&quot;:[0,&quot;Trending feed&quot;],&quot;appPage.bento.trending.text&quot;:[0,&quot;Inspiratie rechtstreeks uit het centrum van alles en een realtime overzicht van wat er nu populair is. Filter verse items van de straten van Praag, Berlijn of Londen en blijf voorop lopen voordat de golf je Instagram overspoelt.&quot;],&quot;appPage.bento.skipTheLine.title&quot;:[0,&quot;Sla de rij over&quot;],&quot;appPage.bento.skipTheLine.text&quot;:[0,&quot;We hebben je bestelling klaar voor afhaal voordat je zelfs maar bij de winkel bent. Bevestig de afhaal in de app, toon de QR-code bij de kassa en loop meteen weg met je nieuwe vondst.&quot;],&quot;appPage.bento.skipTheLine.ticket.order.label&quot;:[0,&quot;Bestelnummer&quot;],&quot;appPage.bento.skipTheLine.ticket.address.label&quot;:[0,&quot;Adres&quot;],&quot;appPage.bento.skipTheLine.ticket.address.value&quot;:[0,&quot;Footshop winkel&quot;],&quot;appPage.bento.wishlist.title&quot;:[0,&quot;Verlanglijst&quot;],&quot;appPage.bento.wishlist.text&quot;:[0,&quot;Houd alles in één plek dat je in de gaten houdt. Zodra een van hen in prijs daalt, laten we het je meteen weten zodat de deal niet aan je voorbijgaat. En je kunt je lijst gemakkelijk delen met vrienden.&quot;],&quot;appPage.bento.wishlist.ui.label&quot;:[0,&quot;Verlanglijst&quot;],&quot;appPage.bento.wishlist.ui.count&quot;:[0,&quot;8 items&quot;],&quot;appPage.bento.wishlist.notification.title&quot;:[0,&quot;Je verlanglijst is in de uitverkoop!&quot;],&quot;appPage.bento.wishlist.notification.text&quot;:[0,&quot;Hurry up, voordat het te laat is 🔥&quot;],&quot;appPage.bento.wishlist.notification.time&quot;:[0,&quot;9:41 uur&quot;],&quot;appPage.steps.title&quot;:[0,&quot;Binnen een paar minuten binnen&quot;],&quot;appPage.steps.lead&quot;:[0,&quot;En alles wat je al weet van de site wacht op je.&quot;],&quot;appPage.steps.download.title&quot;:[0,&quot;Download het&quot;],&quot;appPage.steps.download.text&quot;:[0,&quot;App Store of Google Play. Gratis, in een minuut gedaan.&quot;],&quot;appPage.steps.onboarding.title&quot;:[0,&quot;Doorloop de onboarding&quot;],&quot;appPage.steps.onboarding.text&quot;:[0,&quot;Een paar tikken, geen eindeloze formulieren. Aan het einde log je in met hetzelfde account dat je op de site gebruikt.&quot;],&quot;appPage.steps.preferences.title&quot;:[0,&quot;Vertel ons wat je draagt&quot;],&quot;appPage.steps.preferences.text&quot;:[0,&quot;Maten, merken. De app herinnert je en laat je zien waar je echt om geeft.&quot;],&quot;appPage.steps.shop.title&quot;:[0,&quot;Winkel met de voordelen&quot;],&quot;appPage.steps.shop.text&quot;:[0,&quot;Exclusieve kortingen, pushmeldingen over drops, sla de rij over in de winkel. Dit krijg je niet op het web.&quot;],&quot;appPage.reviews.title&quot;:[0,&quot;Wees als eerste bij alles&quot;],&quot;appPage.reviews.lead&quot;:[0,&quot;Van limited sneakers tot dagelijkse streetwear. Winkel sneller, volg nieuwe aankomsten als eerste en gebruik de voordelen die alleen in de app beschikbaar zijn.&quot;],&quot;appPage.reviews.ratings&quot;:[0,&quot;5,2k beoordelingen&quot;],&quot;appPage.reviews.downloads&quot;:[0,&quot;Downloads&quot;],&quot;appPage.reviews.review.1.text&quot;:[0,&quot;Geweldige app, nooit traag en een enorme keuze aan kleding en schoenen.&quot;],&quot;appPage.reviews.review.1.author&quot;:[0,&quot;Sebastian P.&quot;],&quot;appPage.reviews.review.2.text&quot;:[0,&quot;De beste winkel om kleding te kopen.&quot;],&quot;appPage.reviews.review.2.author&quot;:[0,&quot;Filip V.&quot;],&quot;appPage.reviews.review.3.text&quot;:[0,&quot;Grote aanbieding, snelle levering, kwaliteitsproducten.&quot;],&quot;appPage.reviews.review.3.author&quot;:[0,&quot;Gabriela K.&quot;],&quot;appPage.reviews.review.4.text&quot;:[0,&quot;De app is goed doordacht en slim ingedeeld in categorieën, ik vind het ontwerp echt leuk.&quot;],&quot;appPage.reviews.review.4.author&quot;:[0,&quot;Ema H.&quot;],&quot;appPage.reviews.review.5.text&quot;:[0,&quot;Grote selectie en ik vind altijd iets.&quot;],&quot;appPage.reviews.review.5.author&quot;:[0,&quot;Matyáš J.&quot;],&quot;appPage.reviews.review.6.text&quot;:[0,&quot;Top 10/10&quot;],&quot;appPage.reviews.review.6.author&quot;:[0,&quot;Tomáš B.&quot;],&quot;appPage.manifest.upperText&quot;:[0,&quot;Eén app.{glyph}De hele wereld van sneakers.&quot;],&quot;appPage.manifest.text&quot;:[0,&quot;Meer dan 800.000 mensen houden Footshop al binnen handbereik. Ze winkelen slimmer, vangen meer en missen nooit wat ze willen. Het is geen e-shop in je zak, het is een manier om altijd een stap voor te blijven op iedereen. Nu is het jouw beurt.&quot;],&quot;reviews.colorVariation.label&quot;:[0,&quot;Beoordeling van kleur {colorway}&quot;],&quot;catalog.detail.delivery.cutoff_short&quot;:[0,&quot;Bestel om {time}&quot;],&quot;catalog.detail.delivery.stores.more_count&quot;:[0,&quot;+{count} meer&quot;],&quot;catalog.detail.add_to_cart_short&quot;:[0,&quot;Toevoegen&quot;],&quot;login.modal.headline.reservation&quot;:[0,&quot;We bewaren je reservering van het artikel in de winkel op je account, dus log alsjeblieft in of registreer je.&quot;]}]}]}]}],&quot;locale&quot;:[0,&quot;nl&quot;],&quot;pageName&quot;:[0,&quot;product&quot;],&quot;registrationVoucher&quot;:[0,{&quot;voucherValue&quot;:[0,{&quot;amount&quot;:[0,8],&quot;currency&quot;:[0,&quot;EUR&quot;]}],&quot;minimalOrderValue&quot;:[0,{&quot;amount&quot;:[0,125],&quot;currency&quot;:[0,&quot;EUR&quot;]}]}],&quot;rootData&quot;:[0,{&quot;active_products_count&quot;:[0,6800],&quot;gender&quot;:[0,null],&quot;active_products_category_url&quot;:[0,&quot;https://www.ftshp.nl/nl/1770-sneakers&quot;],&quot;base_url&quot;:[0,&quot;https://www.ftshp.nl/nl/&quot;],&quot;cart_url&quot;:[0,&quot;https://www.ftshp.nl/nl/order/1&quot;],&quot;nof_cart_url&quot;:[0,&quot;https://www.ftshp.nl/nl/order/1&quot;],&quot;currency_sign&quot;:[0,&quot;€&quot;],&quot;currency_iso_code&quot;:[0,&quot;EUR&quot;],&quot;current_shop&quot;:[0,{&quot;id&quot;:[0,22],&quot;id_category&quot;:[0,2],&quot;id_shop_group&quot;:[0,1],&quot;id_shop_list&quot;:[1,[]],&quot;id_theme&quot;:[0,1],&quot;name&quot;:[0,&quot;Nederlands&quot;],&quot;domain&quot;:[0,&quot;ftshp.nl&quot;],&quot;domain_ssl&quot;:[0,&quot;ftshp.nl&quot;],&quot;physical_uri&quot;:[0,&quot;/&quot;],&quot;virtual_uri&quot;:[0,&quot;nl/&quot;],&quot;theme_directory&quot;:[0,&quot;default-bootstrap&quot;],&quot;theme_id&quot;:[0,1],&quot;active&quot;:[0,1],&quot;deleted&quot;:[0,0],&quot;force_id&quot;:[0,false]