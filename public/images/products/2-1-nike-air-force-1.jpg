r_lists_count&quot;:[0,0],&quot;bundles&quot;:[1,[]],&quot;breadcrumbs&quot;:[1,[[0,{&quot;id&quot;:[0,&quot;0&quot;],&quot;name&quot;:[0,&quot;Thuis&quot;],&quot;nameEn&quot;:[0,&quot;Home&quot;],&quot;link&quot;:[0,{&quot;url&quot;:[0,&quot;https://www.ftshp.nl/nl/&quot;]}]}],[0,{&quot;id&quot;:[0,&quot;5&quot;],&quot;name&quot;:[0,&quot;Herenschoenen&quot;],&quot;nameEn&quot;:[0,&quot;Men&#39;s shoes&quot;],&quot;link&quot;:[0,{&quot;url&quot;:[0,&quot;https://www.ftshp.nl/nl/5-herenschoenen&quot;]}]}],[0,{&quot;id&quot;:[0,&quot;5&quot;],&quot;name&quot;:[0,&quot;Nike&quot;],&quot;nameEn&quot;:[0,&quot;Nike&quot;],&quot;link&quot;:[0,{&quot;url&quot;:[0,&quot;https://www.ftshp.nl/nl/5-herenschoenen/merk-nike&quot;]}]}],[0,{&quot;id&quot;:[0,&quot;255&quot;],&quot;name&quot;:[0,&quot;Nike Air Force&quot;],&quot;nameEn&quot;:[0,&quot;Nike Air Force&quot;],&quot;link&quot;:[0,{&quot;url&quot;:[0,&quot;https://www.ftshp.nl/nl/255-nike-air-force&quot;]}]}]]],&quot;properties&quot;:[0,{&quot;details&quot;:[1,[[0,{&quot;id&quot;:[0,&quot;color&quot;],&quot;label&quot;:[0,&quot;Kleur&quot;],&quot;items&quot;:[1,[[0,{&quot;id&quot;:[0,&quot;42&quot;],&quot;value&quot;:[0,&quot;Wit&quot;],&quot;description&quot;:[0,null],&quot;link&quot;:[0,{&quot;url&quot;:[0,&quot;https://www.ftshp.nl/nl/5-herenschoenen/kleur-wit&quot;]}]}]]]}],[0,{&quot;id&quot;:[0,&quot;manufacturer&quot;],&quot;label&quot;:[0,&quot;Merk&quot;],&quot;items&quot;:[1,[[0,{&quot;id&quot;:[0,&quot;25&quot;],&quot;value&quot;:[0,&quot;Nike&quot;],&quot;description&quot;:[0,null],&quot;link&quot;:[0,{&quot;url&quot;:[0,&quot;https://www.ftshp.nl/nl/5-herenschoenen/merk-nike&quot;]}]}]]]}]]],&quot;materials&quot;:[1,[[0,{&quot;id&quot;:[0,&quot;18&quot;],&quot;label&quot;:[0,&quot;Bovenlaag&quot;],&quot;items&quot;:[1,[[0,{&quot;id&quot;:[0,&quot;26&quot;],&quot;value&quot;:[0,&quot;Leer&quot;],&quot;description&quot;:[0,&quot;Natuurlijk leder is een traditioneel materiaal dat ontstaat uit het looiproces van dierlijke huiden en vellen, dat een sleutelpositie inneemt in de schoenen- en fourniturenindustrie vanwege de mechanische weerstand, het ademend vermogen en de esthetische waarde. Door de specifieke reticulaire structuur van de collageenvezels past het materiaal zich aan de anatomie van de gebruiker aan, wat resulteert in optimaal draagcomfort. Als hygroscopisch materiaal reguleert het leer op natuurlijke wijze vocht en zorgt het voor luchtcirculatie. Het uiterlijk en de functionele eigenschappen, zoals de mate van waterafstotendheid of de textuur, worden bepaald door het specifieke type technologische verwerking, waaronder gladde afwerkingen, suède of nubuck.&quot;],&quot;link&quot;:[0,null]}]]]}],[0,{&quot;id&quot;:[0,&quot;19&quot;],&quot;label&quot;:[0,&quot;Tussenzool&quot;],&quot;items&quot;:[1,[[0,{&quot;id&quot;:[0,&quot;904&quot;],&quot;value&quot;:[0,&quot;Air Sole&quot;],&quot;description&quot;:[0,&quot;Legendarisch dempingselement, een capsule gevuld met samengeperste lucht die in de hiel of teen van de schoen wordt geplaatst. Het comprimeert bij impact, absorbeert schokken en vermindert stress op de gewrichten. Dit verhoogt het comfort, de energieteruggave en de duurzaamheid van de schoen en heeft de ontwikkeling van moderne sneakers fundamenteel beïnvloed.&quot;],&quot;link&quot;:[0,null]}]]]}],[0,{&quot;id&quot;:[0,&quot;20&quot;],&quot;label&quot;:[0,&quot;Zool&quot;],&quot;items&quot;:[1,[[0,{&quot;id&quot;:[0,&quot;33&quot;],&quot;value&quot;:[0,&quot;Rubber&quot;],&quot;description&quot;:[0,&quot;De rubberen zool is een traditioneel en zeer betrouwbaar element in de constructie van schoeisel, dat vooral gewaardeerd wordt om zijn extreme mechanische weerstand en grip. Deze contactlaag is gemaakt van natuurlijk of synthetisch rubber, dat wordt gekenmerkt door zijn hoge dichtheid en elasticiteit. Door zijn fysieke eigenschappen biedt het uitstekende tractie op een breed scala aan oppervlakken, van glad asfalt tot onverhard terrein. Bovendien is het rubber van nature waterdicht en bestand tegen temperatuurschommelingen, wat zorgt voor stabiliteit en een veilige tred in verschillende klimatologische omstandigheden.&quot;],&quot;link&quot;:[0,null]}]]]}]]],&quot;cares&quot;:[1,[[0,{&quot;id&quot;:[0,&quot;30&quot;],&quot;label&quot;:[0,&quot;Onderhoudsinstructie&quot;],&quot;items&quot;:[1,[[0,{&quot;id&quot;:[0,&quot;137524&quot;],&quot;value&quot;:[0,&quot;Neprat&quot;],&quot;description&quot;:[0,&quot;&quot;],&quot;link&quot;:[0,null]}]]]}]]],&quot;size_info&quot;:[1,[]],&quot;sustainability&quot;:[1,[]],&quot;notes&quot;:[1,[]]}],&quot;brand&quot;:[0,{&quot;perex&quot;:[0,&quot;Nike is een onbetwiste reus in de wereld van sport en mode. Nike kleding, sneakers en zelfs accessoires behoren al lange tijd tot de beste prijs-kwaliteitsverhouding. Naast de eerder genoemde kleding en accessoires is het succes van het merk vooral te danken aan de sneakers.Innovatie en Nike AirNike is vooral bekend geworden door de legendarische ...&quot;],&quot;description&quot;:[0,&quot;&lt;p&gt;Nike is een onbetwiste reus in de wereld van sport en mode. Nike kleding, sneakers en zelfs accessoires behoren al lange tijd tot de beste prijs-kwaliteitsverhouding. Naast de eerder genoemde kleding en accessoires is het succes van het merk vooral te danken aan de &lt;a href=\&quot;https://www.footshop.cz/cs/1770-tenisky/znacka-nike\&quot;&gt;sneakers&lt;/a&gt;.&lt;/p&gt;\r\n&lt;h3 dir=\&quot;ltr\&quot;&gt;&lt;strong&gt;Innovatie en Nike Air&lt;/strong&gt;&lt;/h3&gt;\r\n&lt;p dir=\&quot;ltr\&quot;&gt;&lt;span&gt;Nike is vooral bekend geworden door&lt;/span&gt;&lt;span&gt; de legendarische Air-technologie&lt;/span&gt;&lt;span&gt;. &lt;/span&gt;&lt;span&gt; De eerste Nike schoenen met de toen vreemde luchtbel kwamen uit in &lt;/span&gt;&lt;span&gt;1987&lt;/span&gt;&lt;span&gt;. &lt;/span&gt;&lt;span&gt; Hun naam staat in het geheugen gegrift van iedereen die ook maar een beetje geïnteresseerd is in Nike schoeisel &lt;/span&gt;&lt;span&gt;- &lt;a href=\&quot;https://www.footshop.cz/cs/1770-tenisky/model-nike_air_max_1\&quot;&gt;Nike Air Max 1&lt;/a&gt;&lt;/span&gt;&lt;span&gt;. De ontwerper van de eerste modelijn Nike sneakers met de zogenaamde Air Sole was &lt;/span&gt;&lt;span&gt;Tinker Hatfield&lt;/span&gt;&lt;span&gt;. Een icoon van de sneakercultuur, dankzij wie we vandaag de dag Nike schoenen met het Air Max label kunnen dragen in een grote variatie aan modellen. &lt;/span&gt;&lt;/p&gt;\r\n&lt;p dir=\&quot;ltr\&quot;&gt;&lt;span&gt;We zouden eeuwen bezig zijn met het opnoemen van alle silhouetten waarin Nike Air Max schoenen tot nu toe zijn uitgebracht. Daarom volstaan we met het noemen van de meest essentiële. De Nike Air Max 1, 90, 95, 97, 98 en de nieuwere Nike sneakers met het Air Max Plus, 270 of 720 label.&lt;/span&gt;&lt;/p&gt;\r\n&lt;h3 dir=\&quot;ltr\&quot;&gt;&lt;strong&gt;Geschiedenis van Nike&lt;/strong&gt;&lt;/h3&gt;\r\n&lt;p dir=\&quot;ltr\&quot;&gt;&lt;span&gt;De oorspronkelijke naam van het bedrijf dat we nu kennen als &lt;/span&gt;&lt;span&gt;Nike&lt;/span&gt;&lt;span&gt;,&lt;/span&gt;&lt;span&gt; &lt;/span&gt; was&lt;span&gt; Blue Ribbon Sports&lt;/span&gt;&lt;span&gt;. &lt;/span&gt;&lt;span&gt; Nike sneakers verschenen pas onder hun huidige naam in &lt;/span&gt;&lt;span&gt;1971&lt;/span&gt;&lt;span&gt;, toen het legendarische merk gezelschap kreeg van het niet minder legendarische logo &lt;/span&gt;&lt;span&gt;- de &lt;/span&gt;&lt;span&gt;Swoosh&lt;/span&gt;&lt;span&gt;. &lt;/span&gt;&lt;span&gt; Dit werd destijds ontworpen door Carolyn Davidson, studente aan de Universiteit van Portland, en haar loon voor dit &lt;/span&gt;&lt;span&gt;zijdelingse ontwerp&lt;/span&gt;&lt;span&gt; was toen slechts twee dollar per uur voor arbeid (vergeleken met de prijzen van vandaag, zou het ruwweg 7 keer zoveel opbrengen). &lt;/span&gt;&lt;/p&gt;\r\n&lt;h3 dir=\&quot;ltr\&quot;&gt;&lt;strong&gt;Meer dan een Air Max&lt;/strong&gt;&lt;/h3&gt;\r\n&lt;p dir=\&quot;ltr\&quot;&gt;&lt;span&gt;Nike schoenen worden echter niet alleen geassocieerd met de hele Air Max lijn. Tegenwoordig heeft het ook een groot aantal eigen uitlopers onder zijn paraplu, waaronder &lt;/span&gt;&lt;span&gt;Nike Skateboarding&lt;/span&gt;&lt;span&gt; (&lt;/span&gt;&lt;span&gt;SB&lt;/span&gt;&lt;span&gt;) &lt;/span&gt;&lt;span&gt;, een &lt;/span&gt;&lt;span&gt;onderdeel van het wereldwijde merk dat ervoor zorgt dat skateboarders tegenwoordig graag &lt;a href=\&quot;https://www.footshop.cz/cs/4-boty/znacka-nike\&quot;&gt;Nike schoenen&lt;/a&gt; dragen. Maar je vindt Nike schoenen ook aan de voeten van basketballers. Noemenswaardig is het legendarische Nike sneakermodel &lt;/span&gt;&lt;span&gt;Blazer&lt;/span&gt;&lt;span&gt;, dat vandaag de dag nog steeds erg populair is. Nike schoenen voor basketbalspelers werden na verloop van tijd zo populair dat in &lt;/span&gt;&lt;span&gt;1984 &lt;/span&gt;&lt;span&gt;het merk &lt;a href=\&quot;https://www.footshop.cz/cs/110-air-jordan\&quot;&gt;Air Jordan&lt;/a&gt; werd opgericht onder de vleugels van Nike&lt;/span&gt;&lt;span&gt;. Oorspronkelijk waren deze Nike schoenen alleen voor de legendarische Michael Jordan, maar niet lang na de introductie waren ze ook in handen van het grote publiek. Naast de verschillende productlijnen kun je bij Footshop ook terecht voor &lt;a href=\&quot;https://www.footshop.cz/cs/1828-pantofle/znacka-nike\&quot;&gt;Nike slippers&lt;/a&gt;. Bovendien vind je alle paren die hier worden genoemd in alle kleuren, inclusief wit, zwart, rood, blauw of gekleurd.&lt;/span&gt;&lt;/p&gt;\r\n&lt;h3 dir=\&quot;ltr\&quot;&gt;&lt;strong&gt;Nike is voor iedereen&lt;/strong&gt;&lt;/h3&gt;\r\n&lt;p dir=\&quot;ltr\&quot;&gt;&lt;span&gt;Nike schoenen worden tegenwoordig echter niet alleen geproduceerd met een focus op bepaalde groepen. &lt;a href=\&quot;https://www.footshop.cz/cs/609-obleceni/znacka-nike\&quot;&gt;Nike kleding&lt;/a&gt; en schoenen categoriseren als sport, lifestyle of mode zou daarom een beetje zonde zijn. Je vindt Nike sweaters, T-shirts, broeken of trainingspakken tegenwoordig op elk sportief, cultureel of ander evenement - kijk bijvoorbeeld naar wat hardlopers dragen bij wedstrijden en je zult zien dat het meestal Nike hardloopschoenen zijn. Nike&#39;s zijn simpelweg synoniem geworden voor een levensstijl; welke dat is, is aan de eigenaar van elk merk. &lt;/span&gt;&lt;/p&gt;\r\n&lt;p dir=\&quot;ltr\&quot;&gt;&lt;span&gt;In de ongeveer 50 jaar van zijn bestaan is &lt;/span&gt;&lt;span&gt;een gewone&lt;/span&gt;&lt;span&gt; Nike &lt;/span&gt;&lt;span&gt;sneaker&lt;/span&gt;&lt;span&gt; met een kenmerkende Swoosh uitgegroeid tot &lt;/span&gt;&lt;span&gt;een fenomeen &lt;/span&gt;&lt;span&gt;van een omvang die niemand zich toen had kunnen voorstellen. In feite zijn Nike schoenen vandaag de dag bij iedereen te vinden &lt;/span&gt;&lt;span&gt;- &lt;/span&gt;&lt;span&gt;atleten, artiesten, artiesten, modeontwerpers en zo kunnen we nog wel even doorgaan. &lt;/span&gt;&lt;/p&gt;\r\n&lt;p dir=\&quot;ltr\&quot;&gt;&lt;span&gt;De vraag is of Nike schoenen ook in jouw schoenenkast te vinden zijn. Als het antwoord ja is, heb je de duim omhoog en het respect van andere Nike sneakerliefhebbers. Als het antwoord nee blijft, heb je nu een unieke kans om daar verandering in te brengen. Bij Footshop hebben we verschillende silhouetten in allerlei kleuren. &lt;/span&gt;&lt;span&gt;Je vindt&lt;/span&gt;&lt;span&gt;hier &lt;/span&gt;&lt;span&gt;ook&lt;/span&gt;&lt;span&gt;Nike schoenen &lt;/span&gt;&lt;span&gt;in beperkte oplages&lt;/span&gt;&lt;span&gt;, &lt;/span&gt;&lt;span&gt; en het zou zonde zijn om daar niet van te profiteren. Maar we zullen je niet langer ophouden en ga lekker shoppen!&lt;/span&gt;&lt;/p&gt;&quot;],&quot;contact&quot;:[0,{&quot;name&quot;:[0,&quot;Nike European Op Netherlands B.V.&quot;],&quot;info&quot;:[0,&quot;&quot;],&quot;address&quot;:[0,&quot;Nike Retail B.V. Zweigniederlassung Deutschland, Warschauer Straße 70A, 10243 Berlin&quot;]}]}],&quot;delivery&quot;:[0,{&quot;link&quot;:[0,&quot;https://www.ftshp.nl/nl/levering&quot;],&quot;isCarrier&quot;:[0,true],&quot;options&quot;:[1,[[0,{&quot;name&quot;:[0,&quot;DPD Pickup&quot;],&quot;minimalPrice&quot;:[0,4],&quot;minimalPriceMoney&quot;:[0,{&quot;amount&quot;:[0,4],&quot;currency&quot;:[0,&quot;EUR&quot;]}],&quot;maximumPrice&quot;:[0,4],&quot;deliveryDate&quot;:[0,null],&quot;text&quot;:[0,&quot;Van Woensdag 30.9.2026&quot;]}],[0,{&quot;name&quot;:[0,&quot;DPD&quot;],&quot;minimalPrice&quot;:[0,5],&quot;minimalPriceMoney&quot;:[0,{&quot;amount&quot;:[0,5],&quot;currency&quot;:[0,&quot;EUR&quot;]}],&quot;maximumPrice&quot;:[0,5],&quot;deliveryDate&quot;:[0,null],&quot;text&quot;:[0,&quot;Van Woensdag 30.9.2026&quot;]}],[0,{&quot;name&quot;:[0,&quot;GLS Europe&quot;],&quot;minimalPrice&quot;:[0,5],&quot;minimalPriceMoney&quot;:[0,{&quot;amount&quot;:[0,5],&quot;currency&quot;:[0,&quot;EUR&quot;]}],&quot;maximumPrice&quot;:[0,5],&quot;deliveryDate&quot;:[0,null],&quot;text&quot;:[0,&quot;Van Donderdag 1.10.2026&quot;]}],[0,{&quot;name&quot;:[0,&quot;FedEx&quot;],&quot;minimalPrice&quot;:[0,21.49],&quot;minimalPriceMoney&quot;:[0,{&quot;amount&quot;:[0,21.49],&quot;currency&quot;:[0,&quot;EUR&quot;]}],&quot;maximumPrice&quot;:[0,21.49],&quot;deliveryDate&quot;:[0,null],&quot;text&quot;:[0,&quot;Van Dinsdag 29.9.2026&quot;]}]]]}],&quot;returns&quot;:[0,{&quot;returnLink&quot;:[0,&quot;https://www.ftshp.nl/nl/retourneren&quot;],&quot;claimLink&quot;:[0,&quot;https://www.ftshp.nl/nl/reclamatie&quot;]}],&quot;campaigns&quot;:[0,{&quot;pdp&quot;:[0,{&quot;info&quot;:[1,[]],&quot;cta&quot;:[1,[]]}]}],&quot;doubleDiscounts&quot;:[0,{&quot;primary&quot;:[0,null],&quot;secondary&quot;:[0,null]}],&quot;mobile_app_only&quot;:[0,false],&quot;sport_only&quot;:[0,false],&quot;has_outfit&quot;:[0,false],&quot;hasFitsWith&quot;:[0,true],&quot;hasShoeFinder&quot;:[0,false],&quot;recommendedSize&quot;:[0,{&quot;hint&quot;:[0,&quot;We raden aan je gebruikelijke maat te kopen.&quot;],&quot;example&quot;: