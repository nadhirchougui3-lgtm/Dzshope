.admin-layout {
  width: 100%;
  min-height: 100vh;
  display: flex;
  align-items: stretch;
  background: #faf9f7;
  color: #1c1c1e;
}

.admin-sidebar {
  width: 258px;
  min-height: 100vh;
  background: #1c1c1e;
  color: #ffffff;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  border-right: 1px solid rgba(250, 249, 247, 0.07);
}

.admin-sidebar-header {
  min-height: 88px;
  box-sizing: border-box;
  padding: 20px 22px;
  display: flex;
  align-items: center;
  gap: 12px;
  border-bottom: 1px solid rgba(250, 249, 247, 0.07);
}

.admin-brand-mark {
  width: 40px;
  height: 40px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  background: #8b1e2d;
  color: #ffffff;
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.8px;
  box-shadow: 0 5px 16px rgba(139, 30, 45, 0.25);
}

.admin-sidebar-title {
  margin: 0;
  color: #ffffff;
  font-size: 16px;
  font-weight: 800;
  letter-spacing: 0.8px;
}

.admin-sidebar-shop {
  color: #8b1e2d;
}

.admin-sidebar-subtitle {
  margin: 3px 0 0;
  color: #888683;
  font-size: 11px;
  font-weight: 500;
}

.admin-sidebar-section {
  padding: 25px 12px 0;
}

.admin-sidebar-section-label {
  display: block;
  padding: 0 12px;
  margin-bottom: 10px;
  color: #6f6d69;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.3px;
}

.admin-nav {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.admin-nav-link {
  min-height: 46px;
  box-sizing: border-box;
  padding: 0 13px;
  display: flex;
  align-items: center;
  gap: 12px;
  border-radius: 8px;
  color: rgba(250, 249, 247, 0.62);
  text-decoration: none;
  font-size: 13px;
  font-weight: 600;
  transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
}

.admin-nav-link:hover {
  background: rgba(139, 30, 45, 0.16);
  color: #faf9f7;
}

.admin-nav-link.active {
  background: #8b1e2d;
  color: #ffffff;
  box-shadow: 0 5px 14px rgba(139, 30, 45, 0.22);
}

.admin-nav-icon {
  width: 24px;
  height: 24px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 6px;
  background: rgba(250, 249, 247, 0.06);
  color: rgba(250, 249, 247, 0.56);
  font-size: 15px;
  line-height: 1;
}

.admin-nav-link:hover .admin-nav-icon {
  background: rgba(139, 30, 45, 0.24);
  color: #faf9f7;
}

.admin-nav-link.active .admin-nav-icon {
  background: rgba(255, 255, 255, 0.13);
  color: #ffffff;
}

.admin-sidebar-bottom {
  margin-top: auto;
  padding: 16px 12px 18px;
  border-top: 1px solid rgba(250, 249, 247, 0.07);
}

.admin-sidebar-account {
  min-height: 54px;
  box-sizing: border-box;
  padding: 8px 9px;
  display: flex;
  align-items: center;
  gap: 10px;
  border-radius: 9px;
  background: rgba(250, 249, 247, 0.045);
  margin-bottom: 10px;
}

.admin-account-avatar {
  width: 32px;
  height: 32px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #292729;
  color: #ffffff;
  font-size: 12px;
  font-weight: 700;
}

.admin-account-info {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.admin-account-info strong {
  color: #e7e5e2;
  font-size: 11px;
  font-weight: 700;
}

.admin-account-info span {
  color: #777572;
  font-size: 10px;
}

.admin-account-status {
  width: 7px;
  height: 7px;
  margin-left: auto;
  flex-shrink: 0;
  border-radius: 50%;
  background: #8b1e2d;
  box-shadow: 0 0 0 3px rgba(139, 30, 45, 0.08);
}

.admin-store-link {
  min-height: 40px;
  box-sizing: border-box;
  padding: 0 10px;
  display: flex;
  align-items: center;
  gap: 9px;
  border-radius: 8px;
  color: rgba(250, 249, 247, 0.45);
  text-decoration: none;
  font-size: 11px;
  font-weight: 600;
  transition: background 0.2s ease, color 0.2s ease;
}

.admin-store-link:hover {
  background: rgba(139, 30, 45, 0.14);
  color: #faf9f7;
}

.admin-store-link span:first-child {
  font-size: 15px;
  color: #8b1e2d;
}

.admin-main {
  min-width: 0;
  min-height: 100vh;
  flex: 1;
  display: flex;
  flex-direction: column;
  background: #faf9f7;
}

.admin-topbar {
  min-height: 76px;
  box-sizing: border-box;
  flex-shrink: 0;
  padding: 0 32px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-bottom: 1px solid #e8e3df;
}

.admin-topbar-label {
  display: block;
  margin-bottom: 2px;
  color: #8b1e2d;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 1.4px;
}

.admin-topbar-title {
  margin: 0;
  color: #1c1c1e;
  font-size: 17px;
  font-weight: 750;
  letter-spacing: -0.15px;
}

.admin-topbar-right {
  display: flex;
  align-items: center;
}

.admin-live-status {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 7px 11px;
  border: 1px solid #e8e3df;
  border-radius: 8px;
  background: #faf9f7;
}

.admin-live-status strong,
.admin-live-status span {
  display: block;
}

.admin-live-status strong {
  color: #383635;
  font-size: 11px;
  font-weight: 700;
}

.admin-live-status div span {
  margin-top: 2px;
  color: #888683;
  font-size: 9px;
}

.admin-status-dot {
  width: 7px;
  height: 7px;
  flex-shrink: 0;
  border-radius: 50%;
  background: #8b1e2d;
  box-shadow: 0 0 0 3px rgba(139, 30, 45, 0.08);
}

.admin-content {
  width: 100%;
  min-width: 0;
  flex: 1;
  box-sizing: border-box;
  padding: 30px 32px 36px;
  background: #faf9f7;
}

.admin-page-header {
  margin-bottom: 25px;
}

.admin-page-eyebrow {
  display: inline-block;
  margin-bottom: 7px;
  color: #8b1e2d;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.5px;
}

.admin-page-title {
  margin: 0;
  color: #1c1c1e;
  font-size: 28px;
  font-weight: 750;
  line-height: 1.2;
  letter-spacing: -0.5px;
}

.admin-page-title span {
  color: #8b1e2d;
}

.admin-page-description {
  margin: 7px 0 0;
  color: #77736f;
  font-size: 13px;
  line-height: 1.5;
}

.admin-card {
  min-width: 0;
  padding: 22px;
  background: #ffffff;
  border: 1px solid #e8e3df;
  border-radius: 12px;
  box-shadow: 0 3px 14px rgba(28, 28, 30, 0.035);
}

.admin-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 20px;
}

.admin-card-title {
  margin: 0;
  color: #1c1c1e;
  font-size: 15px;
  font-weight: 750;
  line-height: 1.3;
}

.admin-card-subtitle {
  margin: 5px 0 0;
  color: #888683;
  font-size: 11px;
  line-height: 1.5;
}

.admin-stat-card {
  position: relative;
  height: 100%;
  box-sizing: border-box;
  padding: 20px;
  overflow: hidden;
  background: #ffffff;
  border: 1px solid #e8e3df;
  border-radius: 12px;
  box-shadow: 0 3px 14px rgba(28, 28, 30, 0.035);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.admin-stat-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 3px;
  height: 100%;
  background: #8b1e2d;
}

.admin-stat-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 7px 20px rgba(28, 28, 30, 0.06);
}

.admin-stat-label {
  margin-bottom: 9px;
  color: #77736f;
  font-size: 11px;
  font-weight: 600;
}

.admin-stat-value {
  color: #1c1c1e;
  font-size: 25px;
  font-weight: 750;
  line-height: 1.15;
}

.admin-stat-accent {
  color: #8b1e2d;
}

/* Tables */

.admin-table-wrapper {
  width: 100%;
  min-width: 0;
  overflow-x: auto;
}

.admin-products-table-scroll {
  width: 100%;
  max-height: 560px;
  overflow-x: auto;
  overflow-y: auto;
  border: 1px solid #e8e3df;
  border-radius: 9px;
  scrollbar-width: thin;
  scrollbar-color: #b8b0ab #f2efec;
}

.admin-products-table-scroll::-webkit-scrollbar {
  width: 9px;
  height: 9px;
}

.admin-products-table-scroll::-webkit-scrollbar-track {
  background: #f2efec;
}

.admin-products-table-scroll::-webkit-scrollbar-thumb {
  background: #b8b0ab;
  border-radius: 20px;
}

.admin-products-table-scroll::-webkit-scrollbar-thumb:hover {
  background: #8b1e2d;
}

.admin-table {
  width: 100%;
  min-width: 850px;
  border-collapse: separate;
  border-spacing: 0;
}

.admin-table th {
  position: sticky;
  top: 0;
  z-index: 2;
  padding: 13px 14px;
  background: #faf9f7;
  border-bottom: 1px solid #e5dfdb;
  color: #625e5a;
  font-size: 12px;
  font-weight: 700;
  text-align: left;
  white-space: nowrap;
}

.admin-table td {
  padding: 13px 14px;
  background: #ffffff;
  border-bottom: 1px solid #eee9e5;
  color: #33302e;
  font-size: 13px;
  vertical-align: middle;
}

.admin-table tbody tr:last-child td {
  border-bottom: none;
}

.admin-table tbody tr:hover td {
  background: #fdfaf8;
}

.admin-product-image {
  width: 52px;
  height: 52px;
  display: block;
  border-radius: 8px;
  object-fit: cover;
  border: 1px solid #e4ded9;
  background: #faf9f7;
}

.admin-product-name {
  display: block;
  max-width: 300px;
  color: #242220;
  line-height: 1.4;
}

.admin-product-category {
  color: #625e5a;
}

.admin-product-price {
  color: #242220;
  white-space: nowrap;
}

.admin-product-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  white-space: nowrap;
}

/* Buttons */

.admin-button {
  border: none;
  border-radius: 7px;
  padding: 9px 14px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: opacity 0.2s ease, transform 0.2s ease, background 0.2s ease;
}

.admin-button:hover {
  opacity: 0.9;
}

.admin-button:active {
  transform: translateY(1px);
}

.admin-button:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

.admin-button-primary {
  background: #8b1e2d;
  color: #ffffff;
}

.admin-button-primary:hover {
  background: #761925;
  opacity: 1;
}

.admin-button-secondary {
  background: #eee9e5;
  color: #33302e;
}

.admin-button-secondary:hover {
  background: #e3ddd8;
  opacity: 1;
}

.admin-button-danger {
  background: #8b1e2d;
  color: #ffffff;
}

.admin-button-danger:hover {
  background: #761925;
  opacity: 1;
}

/* Forms */

.admin-form {
  display: grid;
  gap: 18px;
}

.admin-product-form {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px 20px;
}

.admin-product-form-full {
  grid-column: 1 / -1;
}

.admin-form-group {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.admin-form-label {
  color: #30302e;
  font-size: 13px;
  font-weight: 650;
}

.admin-form-input,
.admin-form-select,
.admin-form-textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 11px 12px;
  border: 1px solid #d9d3ce;
  border-radius: 8px;
  outline: none;
  background: #ffffff;
  color: #22201f;
  font-size: 14px;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.admin-form-input::placeholder,
.admin-form-textarea::placeholder {
  color: #a19b96;
}

.admin-form-input:hover,
.admin-form-select:hover,
.admin-form-textarea:hover {
  border-color: #c8c0bb;
}

.admin-form-input:focus,
.admin-form-select:focus,
.admin-form-textarea:focus {
  border-color: #8b1e2d;
  box-shadow: 0 0 0 3px rgba(139, 30, 45, 0.08);
}

.admin-form-textarea {
  min-height: 115px;
  resize: vertical;
  line-height: 1.5;
}

.admin-input-with-suffix {
  position: relative;
}

.admin-input-with-suffix .admin-form-input {
  padding-right: 48px;
}

.admin-input-with-suffix span {
  position: absolute;
  top: 50%;
  right: 13px;
  transform: translateY(-50%);
  color: #77736f;
  font-size: 12px;
  font-weight: 700;
  pointer-events: none;
}

.admin-form-help {
  color: #88827d;
  font-size: 11px;
  line-height: 1.4;
}

.admin-form-help-success {
  color: #8b1e2d;
}

.admin-file-upload {
  position: relative;
  width: 100%;
}

.admin-file-input {
  position: absolute;
  width: 1px;
  height: 1px;
  opacity: 0;
  overflow: hidden;
  pointer-events: none;
}

.admin-file-label {
  min-height: 72px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 4px;
  padding: 12px 16px;
  border: 1px dashed #c8c0bb;
  border-radius: 9px;
  background: #faf9f7;
  color: #34312f;
  cursor: pointer;
  transition: border-color 0.2s ease, background 0.2s ease;
}

.admin-file-label:hover {
  border-color: #8b1e2d;
  background: #fdf7f8;
}

.admin-file-label-main {
  color: #8b1e2d;
  font-size: 13px;
  font-weight: 700;
}

.admin-file-label-sub {
  color: #88827d;
  font-size: 11px;
}

.admin-form-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 3px;
  padding-top: 4px;
}

/* Alerts and badges */

.admin-alert {
  margin-bottom: 18px;
  padding: 12px 14px;
  border-radius: 8px;
  font-size: 13px;
}

.admin-alert-success {
  background: #f7edef;
  color: #8b1e2d;
  border: 1px solid #ead0d5;
}

.admin-alert-danger {
  background: #f7edef;
  color: #8b1e2d;
  border: 1px solid #ead0d5;
}

.admin-badge {
  min-width: 58px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 5px 9px;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 700;
}

.admin-badge-success {
  background: #f7edef;
  color: #8b1e2d;
}

.admin-badge-warning {
  background: #f5eee2;
  color: #8a5a00;
}

.admin-badge-danger {
  background: #f7edef;
  color: #8b1e2d;
}

.admin-badge-info {
  background: #eee9e5;
  color: #625e5a;
}

.admin-badge-secondary {
  background: #eee9e5;
  color: #55514e;
}

/* Loading */

.admin-loading {
  min-height: 220px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.admin-spinner {
  width: 34px;
  height: 34px;
  border: 3px solid #e5dfdb;
  border-top-color: #8b1e2d;
  border-radius: 50%;
  animation: admin-spin 0.8s linear infinite;
}

@keyframes admin-spin {
  to {
    transform: rotate(360deg);
  }
}

/* Charts */

.admin-chart {
  width: 100%;
}

.admin-chart-bars {
  height: 230px;
  display: flex;
  align-items: flex-end;
  gap: 14px;
  padding: 15px 5px 0;
  border-bottom: 1px solid #e5dfdb;
}

.admin-chart-bar-wrapper {
  height: 100%;
  min-width: 24px;
  flex: 1;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.admin-chart-bar {
  width: 100%;
  max-width: 48px;
  min-height: 4px;
  border-radius: 5px 5px 0 0;
  background: #8b1e2d;
  transition: height 0.3s ease;
}

.admin-chart-labels {
  display: flex;
  gap: 14px;
  padding: 9px 5px 0;
}

.admin-chart-label {
  min-width: 24px;
  flex: 1;
  text-align: center;
  color: #88827d;
  font-size: 11px;
}

.admin-low-stock {
  color: #8b1e2d;
  font-weight: 700;
}

/* Dashboard */

.admin-dashboard-grid {
  width: 100%;
}

.admin-dashboard-list {
  display: flex;
  flex-direction: column;
}

.admin-dashboard-list-item {
  min-height: 52px;
  box-sizing: border-box;
  padding: 11px 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  border-bottom: 1px solid #eee9e5;
}

.admin-dashboard-list-item:last-child {
  border-bottom: none;
}

.admin-dashboard-list-main {
  min-width: 0;
}

.admin-dashboard-list-title {
  display: block;
  overflow: hidden;
  color: #2c2927;
  font-size: 12px;
  font-weight: 650;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.admin-dashboard-list-meta {
  display: block;
  margin-top: 3px;
  color: #92908c;
  font-size: 10px;
}

.admin-dashboard-list-value {
  flex-shrink: 0;
  color: #8b1e2d;
  font-size: 12px;
  font-weight: 750;
}

.admin-dashboard-order {
  padding: 13px 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  border-bottom: 1px solid #eee9e5;
}

.admin-dashboard-order:last-child {
  border-bottom: none;
}

.admin-dashboard-order-main {
  min-width: 0;
}

.admin-dashboard-order-reference {
  display: block;
  color: #292725;
  font-size: 12px;
  font-weight: 750;
}

.admin-dashboard-order-customer {
  display: inline-block;
  max-width: 230px;
  margin-top: 3px;
  overflow: hidden;
  color: #85817d;
  font-size: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.admin-dashboard-order-side {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 9px;
}

.admin-dashboard-order-total {
  color: #292725;
  font-size: 11px;
  font-weight: 700;
  white-space: nowrap;
}

.admin-empty-state {
  padding: 24px 10px;
  text-align: center;
  color: #85817d;
  font-size: 12px;
}

/* Users page */

.admin-users-stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
  margin-bottom: 22px;
}

.admin-users-stat {
  min-width: 0;
  padding: 17px 18px;
  background: #ffffff;
  border: 1px solid #e8e3df;
  border-radius: 10px;
  box-shadow: 0 3px 12px rgba(28, 28, 30, 0.025);
}

.admin-users-stat-label {
  display: block;
  margin-bottom: 9px;
  color: #77736f;
  font-size: 11px;
  font-weight: 600;
}

.admin-users-stat-value {
  display: block;
  color: #1c1c1e;
  font-size: 25px;
  font-weight: 750;
  line-height: 1.2;
}

.admin-users-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 14px;
  margin-bottom: 18px;
}

.admin-users-search {
  position: relative;
  flex: 1 1 240px;
  min-width: 180px;
  max-width: 390px;
}

.admin-users-search input {
  width: 100%;
  min-height: 42px;
  box-sizing: border-box;
  padding: 10px 13px;
  border: 1px solid #d9d3ce;
  border-radius: 8px;
  outline: none;
  background: #ffffff;
  color: #22201f;
  font-size: 13px;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.admin-users-search input::placeholder {
  color: #a19b96;
}

.admin-users-search input:focus {
  border-color: #8b1e2d;
  box-shadow: 0 0 0 3px rgba(139, 30, 45, 0.08);
}

.admin-users-role-filter {
  min-width: 150px;
  min-height: 42px;
  box-sizing: border-box;
  padding: 9px 32px 9px 12px;
  border: 1px solid #d9d3ce;
  border-radius: 8px;
  outline: none;
  background: #ffffff;
  color: #33302e;
  font-size: 13px;
  cursor: pointer;
}

.admin-users-role-filter:focus {
  border-color: #8b1e2d;
  box-shadow: 0 0 0 3px rgba(139, 30, 45, 0.08);
}

.admin-users-tabs {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 18px;
  padding: 5px;
  width: fit-content;
  max-width: 100%;
  background: #eee9e5;
  border-radius: 9px;
}

.admin-users-tabs button {
  min-height: 34px;
  padding: 7px 13px;
  border: 1px solid transparent;
  border-radius: 6px;
  background: transparent;
  color: #625e5a;
  font-size: 12px;
  font-weight: 650;
  cursor: pointer;
  transition: background 0.2s ease, color 0.2s ease;
}

.admin-users-tabs button:hover {
  color: #1c1c1e;
  background: rgba(255, 255, 255, 0.55);
}

.admin-users-tabs button.active {
  background: #ffffff;
  color: #8b1e2d;
  border-color: #e8e3df;
  box-shadow: 0 1px 3px rgba(28, 28, 30, 0.05);
}

.admin-users-empty {
  padding: 44px 20px;
  text-align: center;
  background: #ffffff;
  border: 1px dashed #d9d3ce;
  border-radius: 10px;
}

.admin-users-empty strong {
  display: block;
  margin-bottom: 6px;
  color: #33302e;
  font-size: 14px;
}

.admin-users-empty p {
  margin: 0;
  color: #88827d;
  font-size: 12px;
  line-height: 1.6;
}

.admin-users-table-scroll {
  width: 100%;
  max-height: 560px;
  overflow: auto;
  border: 1px solid #e8e3df;
  border-radius: 9px;
  scrollbar-width: thin;
  scrollbar-color: #b8b0ab #f2efec;
}

.admin-users-table-scroll::-webkit-scrollbar {
  width: 9px;
  height: 9px;
}

.admin-users-table-scroll::-webkit-scrollbar-track {
  background: #f2efec;
}

.admin-users-table-scroll::-webkit-scrollbar-thumb {
  background: #b8b0ab;
  border-radius: 20px;
}

.admin-users-table-scroll::-webkit-scrollbar-thumb:hover {
  background: #8b1e2d;
}

.admin-users-table {
  width: 100%;
  min-width: 900px;
  border-collapse: separate;
  border-spacing: 0;
}

.admin-users-table th {
  position: sticky;
  top: 0;
  z-index: 2;
  padding: 13px 14px;
  background: #faf9f7;
  border-bottom: 1px solid #e5dfdb;
  color: #625e5a;
  font-size: 12px;
  font-weight: 700;
  text-align: left;
  white-space: nowrap;
}

.admin-users-table td {
  padding: 13px 14px;
  background: #ffffff;
  border-bottom: 1px solid #eee9e5;
  color: #33302e;
  font-size: 12px;
  vertical-align: middle;
}

.admin-users-table tbody tr:last-child td {
  border-bottom: none;
}

.admin-users-table tbody tr:hover td {
  background: #fdfaf8;
}

.admin-users-name {
  display: block;
  color: #242220;
  font-size: 13px;
  font-weight: 700;
}

.admin-users-secondary {
  display: block;
  margin-top: 4px;
  color: #88827d;
  font-size: 11px;
  overflow-wrap: anywhere;
}

.admin-users-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 7px;
}

.admin-users-actions .admin-button {
  padding: 7px 10px;
  font-size: 11px;
}

.admin-users-actions .admin-button:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

/* Responsive */

@media (max-width: 1200px) {
  .admin-content {
    padding: 26px;
  }

  .admin-users-stats {
    gap: 10px;
  }

  .admin-users-stat {
    padding: 15px;
  }
}

@media (max-width: 992px) {
  .admin-sidebar {
    width: 220px;
  }

  .admin-topbar {
    padding: 0 22px;
  }

  .admin-content {
    padding: 22px;
  }

  .admin-product-form {
    grid-template-columns: 1fr;
  }

  .admin-product-form-full {
    grid-column: auto;
  }

  .admin-products-table-scroll,
  .admin-users-table-scroll {
    max-height: 520px;
  }

  .admin-users-stats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 768px) {
  .admin-layout {
    display: block;
  }

  .admin-sidebar {
    width: 100%;
    min-height: auto;
  }

  .admin-sidebar-header {
    min-height: 72px;
    padding: 16px 18px;
  }

  .admin-sidebar-section {
    padding-top: 14px;
  }

  .admin-sidebar-section-label {
    display: none;
  }

  .admin-nav {
    padding: 0 10px 10px;
    flex-direction: row;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .admin-nav-link {
    min-width: max-content;
  }

  .admin-sidebar-bottom {
    display: none;
  }

  .admin-main {
    min-height: auto;
  }

  .admin-topbar {
    min-height: 64px;
    padding: 0 18px;
  }

  .admin-live-status {
    padding: 6px 8px;
  }

  .admin-content {
    min-height: auto;
    padding: 18px;
  }

  .admin-page-title {
    font-size: 23px;
  }

  .admin-card,
  .admin-stat-card {
    padding: 17px;
  }

  .admin-products-table-scroll,
  .admin-users-table-scroll {
    max-height: 480px;
  }

  .admin-product-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .admin-product-actions .admin-button {
    width: 100%;
  }

  .admin-users-toolbar {
    align-items: stretch;
  }

  .admin-users-search {
    max-width: none;
    flex-basis: 100%;
  }

  .admin-users-role-filter {
    flex: 1;
  }

  .admin-users-tabs {
    width: 100%;
    box-sizing: border-box;
  }

  .admin-users-tabs button {
    flex: 1;
    padding-right: 8px;
    padding-left: 8px;
  }
}

@media (max-width: 480px) {
  .admin-topbar-label {
    display: none;
  }

  .admin-topbar-title {
    font-size: 15px;
  }

  .admin-live-status div {
    display: none;
  }

  .admin-content {
    padding: 14px;
  }

  .admin-stat-value {
    font-size: 21px;
  }

  .admin-card {
    padding: 15px;
    border-radius: 10px;
  }

  .admin-page-title {
    font-size: 21px;
  }

  .admin-page-description {
    font-size: 13px;
  }

  .admin-products-table-scroll,
  .admin-users-table-scroll {
    max-height: 430px;
  }

  .admin-form-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .admin-form-actions .admin-button {
    width: 100%;
  }

  .admin-dashboard-order {
    align-items: flex-start;
    flex-direction: column;
  }

  .admin-dashboard-order-side {
    width: 100%;
    justify-content: space-between;
  }

  .admin-users-stats {
    gap: 9px;
  }

  .admin-users-stat {
    padding: 13px;
  }

  .admin-users-stat-label {
    font-size: 10px;
  }

  .admin-users-stat-value {
    font-size: 22px;
  }

  .admin-users-tabs {
    gap: 3px;
    padding: 4px;
  }

  .admin-users-tabs button {
    font-size: 11px;
  }
}

/* ==================================================
   Admin Users — Luxury Editorial
   Scoped styles: users page only
================================================== */

.admin-users-page {
  width: 100%;
  max-width: 1480px;
  margin: 0 auto;
  color: #1c1c1e;
}

.admin-users-page-header {
  margin-bottom: 30px;
}

.admin-users-page .admin-page-eyebrow {
  letter-spacing: 1.8px;
}

.admin-users-page .admin-page-title {
  font-size: clamp(25px, 2.2vw, 31px);
  letter-spacing: -0.7px;
}

.admin-users-page .admin-page-description {
  max-width: 600px;
  line-height: 1.8;
}

.admin-users-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
}

.admin-users-error .admin-button {
  flex-shrink: 0;
}

.admin-users-stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0;
  margin-bottom: 30px;
  background: #ffffff;
  border: 1px solid #e8e3df;
  border-radius: 10px;
  box-shadow: 0 2px 10px rgba(28, 28, 30, 0.025);
}

.admin-users-stat {
  min-width: 0;
  padding: 23px 24px;
  background: transparent;
  border: 0;
  border-right: 1px solid #eee9e5;
  border-radius: 0;
  box-shadow: none;
}

.admin-users-stat:last-child {
  border-right: 0;
}

.admin-users-stat-label {
  display: block;
  margin-bottom: 13px;
  color: #77736f;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.1px;
}

.admin-users-stat-value {
  display: block;
  color: #1c1c1e;
  font-size: 29px;
  font-weight: 700;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.admin-users-stat-caption {
  display: block;
  margin-top: 9px;
  color: #99938e;
  font-size: 10px;
  line-height: 1.5;
}

.admin-users-card {
  padding: 26px;
  border-color: #e8e3df;
  border-radius: 10px;
  box-shadow: 0 2px 12px rgba(28, 28, 30, 0.025);
}

.admin-users-card-header {
  align-items: center;
  margin-bottom: 24px;
  padding-bottom: 20px;
  border-bottom: 1px solid #eee9e5;
}

.admin-users-section-eyebrow {
  display: block;
  margin-bottom: 8px;
  color: #8b1e2d;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 1.5px;
}

.admin-users-card .admin-card-title {
  font-size: 17px;
  font-weight: 700;
  letter-spacing: -0.2px;
}

.admin-users-card .admin-card-subtitle {
  margin-top: 7px;
  font-size: 12px;
}

.admin-users-total-label {
  flex-shrink: 0;
  padding: 7px 10px;
  border: 1px solid #e8e3df;
  border-radius: 5px;
  background: #faf9f7;
  color: #625e5a;
  font-size: 11px;
  font-weight: 600;
}

.admin-users-toolbar {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 20px;
}

.admin-users-search {
  position: relative;
  display: flex;
  align-items: center;
  flex: 1 1 300px;
  max-width: 520px;
  min-width: 0;
}

.admin-users-search .admin-users-search-icon {
  position: absolute;
  left: 13px;
  z-index: 1;
  color: #8b1e2d;
  font-size: 22px;
  line-height: 1;
  pointer-events: none;
}

.admin-users-search input {
  width: 100%;
  min-width: 0;
  min-height: 43px;
  box-sizing: border-box;
  padding: 10px 38px;
  border: 1px solid #e2dcd7;
  border-radius: 6px;
  outline: none;
  background: #ffffff;
  color: #1c1c1e;
  font-family: inherit;
  font-size: 12px;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.admin-users-search input::placeholder {
  color: #a19b96;
}

.admin-users-search input:focus {
  border-color: #8b1e2d;
  box-shadow: 0 0 0 3px rgba(139, 30, 45, 0.07);
}

.admin-users-search > button {
  position: absolute;
  right: 9px;
  width: 25px;
  height: 25px;
  padding: 0;
  border: 0;
  border-radius: 4px;
  background: transparent;
  color: #77736f;
  font-size: 20px;
  cursor: pointer;
}

.admin-users-search > button:hover {
  background: #f7edef;
  color: #8b1e2d;
}

.admin-users-role-filter {
  min-width: 175px;
  min-height: 43px;
  padding: 9px 32px 9px 12px;
  border: 1px solid #e2dcd7;
  border-radius: 6px;
  outline: none;
  background-color: #ffffff;
  color: #33302e;
  font-family: inherit;
  font-size: 12px;
  cursor: pointer;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.admin-users-role-filter:focus {
  border-color: #8b1e2d;
  box-shadow: 0 0 0 3px rgba(139, 30, 45, 0.07);
}

.admin-users-tabs {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 5px;
  width: fit-content;
  max-width: 100%;
  margin-bottom: 18px;
  padding: 4px;
  border: 1px solid #eee9e5;
  border-radius: 6px;
  background: #f4f1ee;
}

.admin-users-tabs button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 34px;
  padding: 7px 13px;
  border: 1px solid transparent;
  border-radius: 4px;
  background: transparent;
  color: #77736f;
  font-family: inherit;
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.2s ease, color 0.2s ease;
}

.admin-users-tabs button span {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 19px;
  height: 19px;
  padding: 0 4px;
  box-sizing: border-box;
  border-radius: 4px;
  background: rgba(28, 28, 30, 0.045);
  color: inherit;
  font-size: 10px;
  font-variant-numeric: tabular-nums;
}

.admin-users-tabs button:hover {
  color: #1c1c1e;
  background: rgba(255, 255, 255, 0.7);
}

.admin-users-tabs button.active {
  border-color: #e8e3df;
  background: #ffffff;
  color: #8b1e2d;
  box-shadow: 0 1px 3px rgba(28, 28, 30, 0.035);
}

.admin-users-tabs button.active span {
  background: #f7edef;
  color: #8b1e2d;
}

.admin-users-table-scroll {
  width: 100%;
  max-height: 560px;
  overflow: auto;
  border: 1px solid #e8e3df;
  border-radius: 7px;
  scrollbar-width: thin;
  scrollbar-color: #c5bcb6 #f4f1ee;
}

.admin-users-table-scroll::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

.admin-users-table-scroll::-webkit-scrollbar-track {
  background: #f4f1ee;
}

.admin-users-table-scroll::-webkit-scrollbar-thumb {
  border-radius: 10px;
  background: #c5bcb6;
}

.admin-users-table-scroll::-webkit-scrollbar-thumb:hover {
  background: #8b1e2d;
}

.admin-users-table {
  width: 100%;
  min-width: 900px;
  border-collapse: separate;
  border-spacing: 0;
}

.admin-users-table th {
  position: sticky;
  top: 0;
  z-index: 2;
  padding: 14px 15px;
  border-bottom: 1px solid #e8e3df;
  background: #f8f6f3;
  color: #77716c;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.25px;
  text-align: left;
  white-space: nowrap;
}

.admin-users-table td {
  padding: 15px;
  border-bottom: 1px solid #f0ece8;
  background: #ffffff;
  color: #484440;
  font-size: 11px;
  vertical-align: middle;
}

.admin-users-table tbody tr:last-child td {
  border-bottom: 0;
}

.admin-users-table tbody tr:hover td {
  background: #fdfaf8;
}

.admin-users-table .admin-users-client-cell {
  min-width: 170px;
}

.admin-users-client-name {
  display: block;
  color: #242220;
  font-size: 12px;
  font-weight: 700;
  line-height: 1.5;
}

.admin-users-client-contact {
  display: block;
  max-width: 210px;
  margin-top: 4px;
  overflow-wrap: anywhere;
  color: #8a847e;
  font-size: 10px;
  line-height: 1.5;
}

.admin-users-table .admin-badge {
  min-width: 0;
  gap: 6px;
  padding: 5px 8px;
  border-radius: 4px;
  font-size: 10px;
  font-weight: 600;
  white-space: nowrap;
}

.admin-users-table .admin-badge-role-admin {
  background: #f7edef;
  color: #8b1e2d;
}

.admin-users-table .admin-badge-secondary {
  background: #f1efec;
  color: #625e5a;
}

.admin-users-table .admin-badge-success {
  background: #f7edef;
  color: #8b1e2d;
}

.admin-users-table .admin-badge-danger {
  background: #f1efec;
  color: #625e5a;
}

.admin-users-status-dot {
  display: inline-block;
  width: 6px;
  height: 6px;
  flex-shrink: 0;
  border-radius: 50%;
  background: currentColor;
}

.admin-users-spent {
  color: #292725 !important;
  font-weight: 650;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.admin-users-date {
  color: #77716c !important;
  white-space: nowrap;
}

.admin-users-actions {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: 6px;
}

.admin-users-actions .admin-button {
  min-height: 29px;
  padding: 6px 9px;
  border: 1px solid transparent;
  border-radius: 4px;
  font-family: inherit;
  font-size: 10px;
  font-weight: 600;
  white-space: nowrap;
}

.admin-users-actions .admin-button-secondary {
  border-color: #e5dfda;
  background: #ffffff;
  color: #504b47;
}

.admin-users-actions .admin-button-secondary:hover:not(:disabled) {
  border-color: #c9bdb6;
  background: #f8f6f3;
  opacity: 1;
}

.admin-users-actions .admin-button-primary {
  background: #8b1e2d;
  color: #ffffff;
}

.admin-users-actions .admin-button-primary:hover:not(:disabled) {
  background: #761925;
  opacity: 1;
}

.admin-users-actions .admin-button-danger {
  border-color: #ead0d5;
  background: #f7edef;
  color: #8b1e2d;
}

.admin-users-actions .admin-button-danger:hover:not(:disabled) {
  border-color: #dcb8bf;
  background: #f1e2e5;
  opacity: 1;
}

.admin-users-actions .admin-button:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.admin-users-empty {
  padding: 48px 20px;
  border-color: #e5dfda;
  border-radius: 7px;
  background: #fdfcfb;
}

.admin-users-empty strong {
  color: #292725;
  font-size: 14px;
}

.admin-users-empty p {
  margin: 7px 0 18px;
  color: #89837e;
  font-size: 12px;
  line-height: 1.7;
}

.admin-users-empty .admin-button {
  border: 1px solid #e5dfda;
  background: #ffffff;
  color: #8b1e2d;
}

@media (max-width: 1200px) {
  .admin-users-stats {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .admin-users-stat {
    padding: 19px 16px;
  }

  .admin-users-card {
    padding: 22px;
  }
}

@media (max-width: 992px) {
  .admin-users-stats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .admin-users-stat:nth-child(2) {
    border-right: 0;
  }

  .admin-users-stat:nth-child(-n + 2) {
    border-bottom: 1px solid #eee9e5;
  }

  .admin-users-stat-value {
    font-size: 26px;
  }

  .admin-users-card {
    padding: 20px;
  }
}

@media (max-width: 768px) {
  .admin-users-page-header {
    margin-bottom: 22px;
  }

  .admin-users-stats {
    margin-bottom: 22px;
  }

  .admin-users-stat {
    padding: 17px;
  }

  .admin-users-toolbar {
    align-items: stretch;
    flex-direction: column;
  }

  .admin-users-search {
    max-width: none;
    flex-basis: auto;
    width: 100%;
  }

  .admin-users-role-filter {
    width: 100%;
  }

  .admin-users-tabs {
    width: 100%;
    box-sizing: border-box;
  }

  .admin-users-tabs button {
    flex: 1;
    padding-right: 8px;
    padding-left: 8px;
  }

  .admin-users-table-scroll {
    max-height: 480px;
  }
}

@media (max-width: 480px) {
  .admin-users-page .admin-page-title {
    font-size: 23px;
  }

  .admin-users-page .admin-page-description {
    font-size: 12px;
  }

  .admin-users-stats {
    border-radius: 7px;
  }

  .admin-users-stat {
    padding: 15px 12px;
  }

  .admin-users-stat-label {
    margin-bottom: 10px;
    font-size: 10px;
  }

  .admin-users-stat-value {
    font-size: 23px;
  }

  .admin-users-stat-caption {
    font-size: 9px;
  }

  .admin-users-card {
    padding: 15px;
  }

  .admin-users-card-header {
    align-items: flex-start;
    gap: 10px;
  }

  .admin-users-total-label {
    padding: 6px 7px;
    font-size: 10px;
  }

  .admin-users-tabs button {
    gap: 5px;
    font-size: 10px;
  }

  .admin-users-error {
    align-items: flex-start;
    flex-direction: column;
  }
}
